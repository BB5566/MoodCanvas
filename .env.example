# MoodCanvas 環境變數
# 複製此檔案為 .env 再填入實際內容

# ====================================================================
# AI 服務（沒填對應的金鑰，該功能就無法使用）
# ====================================================================

# Replicate：生成日記圖片（必須）
# 註冊：https://replicate.com/account/api-tokens
# 模型：black-forest-labs/flux-schnell
REPLICATE_API_KEY="r8_your-token-here"

# Pioneer：生成心情短語與儀表板洞察（必須）
# 註冊：https://pioneer.ai
# 模型：deepseek-ai/DeepSeek-V4-Pro
PIONEER_API_KEY="pio_sk_your-key-here"

# ====================================================================
# 資料庫（可選，預設用 SQLite，不用設定）
# ====================================================================

# sqlite（預設）或 mysql
DB_TYPE=sqlite
# SQLite 檔案位置，預設 data/moodcanvas.sqlite。Docker 請指到掛載的資料夾
# DB_PATH=/var/www/html/data/moodcanvas.sqlite

# 以下只有 DB_TYPE=mysql 才需要
# 本機填 localhost；用 docker compose 時改成 MySQL 服務的名稱
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mood_canvas_db
DB_USER=mood_user
DB_PASS=your_secure_password

# ====================================================================
# 應用程式（可選）
# ====================================================================

DEBUG=false
APP_URL=https://your-domain.com

# 使用 public/image-resize.php 管理工具時才需要，沒設定就無法使用
# ADMIN_PASSWORD=
